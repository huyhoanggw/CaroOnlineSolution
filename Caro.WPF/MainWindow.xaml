<Window x:Class="Caro.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Caro.WPF"
        mc:Ignorable="d"
        Title="Caro" Height="1000" Width="1210">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="200"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <ItemsControl Background="AliceBlue"
            ItemsSource="{Binding Maps,UpdateSourceTrigger =PropertyChanged ,Mode=TwoWay}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="25" Columns="25"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>


            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button 
                Background="AntiqueWhite"
                 Content="{Binding Content}" 
                Width="40"
                Height="40"
                Click="Button_Click"></Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>


        </ItemsControl>
        <StackPanel Grid.Column="1">
            <Border BorderBrush="Silver"
                    BorderThickness="0,0,0,5"
                    Padding="0,0,0,10">

                <TextBlock TextWrapping="Wrap"
                FontSize="20" Margin="20" 
                Text="{Binding notify }"
                 ></TextBlock>

            </Border>


            <TextBlock TextWrapping="Wrap"
                       FontSize="30" Margin="20" 
                       Text="{Binding TurnStatus }"></TextBlock>
            <TextBlock Foreground="OrangeRed" FontFamily="Bookman Old Style" TextWrapping="Wrap"
                       FontSize="30" Margin="20" 
                       Text="{Binding CurrentStatus  , 
                StringFormat='Lượt chơi hiện tại là : {0}' }"></TextBlock>
        </StackPanel>
    </Grid>
</Window>
